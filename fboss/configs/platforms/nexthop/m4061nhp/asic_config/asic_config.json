{
  "platform_name": "m4061nhp",
  "vendor": "broadcom",
  "asic": "tomahawk6",
  "num_ports_per_core": 1,
  "defaults": {
    "asic_config_params": {
      "config_type": "YAML_CONFIG",
      "exact_match": false,
      "mmu_lossless": false,
      "config_gen_type": "DEFAULT"
    },
    "port_config": {
      "default_speed": 1600000,
      "speed_to_fec": {
        "400000": "PC_FEC_RS544_2XN",
        "800000": "PC_FEC_RS544_2XN",
        "1600000": "PC_FEC_RS544_2XN_IEEE"
      }
    },
    "cpu_port": {
      "speed": 10000,
      "num_lanes": 1
    },
    "mgmt_port": {
      "enabled": true
    },
    "mgmt_port_overrides": [
      {
        "logical_id": 268,
        "physical_id": 514,
        "speed": 100000,
        "num_lanes": 4,
        "fec": "PC_FEC_RS528"
      }
    ],
    "port_mapping_overrides": {
      "num_logical_ports_per_datapath": 17
    },
    "platform_sai_overrides": {
      "pktio_mode": 1,
      "vlan_flooding_l2mc_num_reserved": 0,
      "shared_block_mask_section": "uc_bc",
      "skip_protocol_default_entries": 1,
      "sai_feat_tail_timestamp": 0,
      "sai_port_phy_time_sync_en": 1,
      "l3_intf_vlan_split_egress": 1,
      "sai_stats_disable_mask": "0x200",
      "l3_alpm_large_vrf_mode": 1,
      "sai_ip_counter_cstats": 1,
      "default_cpu_tx_queue": 7
    },
    "conditional_settings": [
      {
        "name": "m4061nhp_mmu_tables",
        "condition": {
          "source": "asic_config_params",
          "param": "config_gen_type",
          "equals": "DEFAULT"
        },
        "apply": {
          "TM_THD_CONFIG": {
            "MIRROR_ON_DROP_RESERVATION": 0,
            "SKIP_BUFFER_RESERVATION": 1
          }
        },
        "skip_from_sai_common": [
          "sai_optimized_mmu",
          "sai_mmu_qgroups_default"
        ]
      }
    ],
    "features": {
      "generate_dlb_config": true,
      "generate_dlb_ecmp_config": true,
      "generate_low_clock_freq_settings": false,
      "generate_autoload_board_settings": true
    }
  },
  "variants": {
    "default": {}
  }
}
