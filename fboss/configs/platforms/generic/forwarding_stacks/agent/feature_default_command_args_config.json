        "configProfiles": {
          "included": [
            "hw_test"
          ]
        },
        "asicTypes": {
          "included": [
            "ASIC_TYPE_EBRO",
            "ASIC_TYPE_G202X",
            "ASIC_TYPE_JERICHO3",
            "ASIC_TYPE_JERICHO4",
            "ASIC_TYPE_QUMRAN4D",
            "ASIC_TYPE_YUBA"
          ]
        }
      }
    },
    "enable_acl_table_group": {
      "args": {
        "enable_acl_table_group": "true"
      },
      "autoEnableWhen": {
        "configProfiles": {
          "included": [
            "hw_test"
          ]
        },
        "asicTypes": {
          "excluded": [
            "ASIC_TYPE_EBRO",
            "ASIC_TYPE_RAMON3"
          ]
        }
      }
    },
    "dual_stage_rdsw_3q_2q": {
      "args": {
