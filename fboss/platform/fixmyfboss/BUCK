load("@fbcode_macros//build_defs:cpp_binary.bzl", "cpp_binary")
load("@fbcode_macros//build_defs:cpp_library.bzl", "cpp_library")
load("@fbcode_macros//build_defs:cpp_unittest.bzl", "cpp_unittest")
load("@fbsource//tools/build_defs/testinfra:network_access_utils.bzl", "network_access_utils")
load("//fbpkg:fbpkg.bzl", "fbpkg")

oncall("fboss_platform")

cpp_library(
    name = "result_printer",
    srcs = [
        "ResultPrinter.cpp",
    ],
    headers = [
        "ResultPrinter.h",
    ],
    exported_deps = [
        "//fboss/platform/platform_checks:check_types-cpp2-types",
    ],
)

cpp_library(
    name = "check_runner",
    srcs = [
        "CheckRunner.cpp",
    ],
    headers = [
        "CheckRunner.h",
    ],
    deps = [
        "//folly/logging:logging",
    ],
    exported_deps = [
        "//fboss/platform/platform_checks:platform_check",
    ],
)

cpp_library(
    name = "check_registry",
    srcs = [
        "CheckRegistry.cpp",
    ],
    headers = [
        "CheckEnvironment.h",
        "CheckRegistry.h",
    ],
    deps = [
        "//fboss/platform/platform_checks:platform_checks",
    ],
    exported_deps = [
        "//fboss/platform/platform_checks:host",
        "//fboss/platform/platform_checks:platform_check",
    ],
)

cpp_binary(
    name = "fixmyfboss",
    srcs = [
        "main.cpp",
    ],
    deps = [
        ":check_registry",
        ":check_runner",
        ":result_printer",
        "//fboss/platform/platform_checks:host",
        "//fboss/platform/platform_checks:platform_name",
        "//folly/logging:logging",
    ],
    external_deps = [
        "CLI11",
    ],
)

fbpkg.builder(
    name = "fboss.fixmyfboss",
    architectures = ["x86_64"],
    path_actions = {
        "fixmyfboss": "//fboss/platform/fixmyfboss:fixmyfboss",
    },
)

cpp_unittest(
