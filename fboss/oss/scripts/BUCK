load("@fbcode_macros//build_defs:python_binary.bzl", "python_binary")
load("@fbcode_macros//build_defs:python_library.bzl", "python_library")

oncall("fboss_distro")

python_library(
    name = "platform_descriptor_utils",
    srcs = ["platform_descriptor_utils.py"],
    labels = ["autodeps2_generated"],
)

python_library(
    name = "sdk_versions",
    srcs = ["sdk_versions.py"],
    labels = ["autodeps2_generated"],
)

python_library(
    name = "npu_sdk_utils_lib",
    srcs = ["npu_sdk_utils.py"],
    # The OSS package installs this beside its callers in /opt/fboss/bin.
    # @lint-ignore BUCKLINT no_base_module_usage_python
    base_module = "",
    labels = ["autodeps2_generated"],
)

python_binary(
    name = "npu_sdk_utils",
    main_module = "npu_sdk_utils",
    deps = [":npu_sdk_utils_lib"],
)

python_library(
    name = "package_lib",
    srcs = ["package.py"],
    labels = ["autodeps2_generated"],
    deps = [":platform_descriptor_utils"],
)

python_binary(
    name = "package",
    main_module = "fboss.oss.scripts.package",
    deps = [":package_lib"],
)

python_library(
    name = "getdeps_fallback_mirror_lib",
    srcs = ["getdeps_fallback_mirror.py"],
    labels = ["autodeps2_generated"],
)

python_binary(
    name = "getdeps_fallback_mirror",
    main_module = "fboss.oss.scripts.getdeps_fallback_mirror",
    deps = [":getdeps_fallback_mirror_lib"],
)
