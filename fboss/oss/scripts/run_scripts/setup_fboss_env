# Derive FBOSS root from this script's location (script lives at $FBOSS/bin/setup_fboss_env)
_FBOSS_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Tab completion for fboss2 / fboss2-dev in interactive bash sessions. The
# script is sourced directly rather than left to bash-completion's lazy
# loader, which only searches /usr/share and XDG_DATA_DIRS, not this tree.
# This runs before the idempotency check because completion specs, unlike
# the exported variables below, are not inherited by child shells.
if [[ -n "${BASH_VERSION:-}" && $- == *i* &&
  -f "${_FBOSS_ROOT}/share/bash-completion/completions/fboss2" ]]; then
  # shellcheck source=/dev/null
  . "${_FBOSS_ROOT}/share/bash-completion/completions/fboss2"
fi

# Idempotent: skip if already sourced with the same root
if [[ "${FBOSS:-}" == "$_FBOSS_ROOT" ]]; then
  unset _FBOSS_ROOT
  return 0 2>/dev/null || true
fi

export FBOSS=$_FBOSS_ROOT
export FBOSS_BIN=${FBOSS}/bin
export FBOSS_LIB=${FBOSS}/lib
export FBOSS_LIB64=${FBOSS}/lib64
export FBOSS_KMODS=${FBOSS}/lib/modules
export FBOSS_DATA=${FBOSS}/share

export PATH=${FBOSS_BIN}${PATH:+:${PATH}}
export LD_LIBRARY_PATH=${FBOSS_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
export LD_LIBRARY_PATH=${FBOSS_LIB64}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}

unset _FBOSS_ROOT
