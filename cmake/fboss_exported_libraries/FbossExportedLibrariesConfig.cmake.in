# When BGP calls find_package(FbossExportedLibraries), CMake executes the
# generated package config to:
# 1. Find Boost, Glog, Folly, fmt, fizz, wangle, and FBThrift.
# 2. Load FbossExportedLibrariesTargets.cmake, which defines:
#    - FBOSS::NodeBase
#    - FBOSS::RadixTree
#    - FBOSS::ExponentialBackoff
#    - FBOSS::LogThriftCall
#    - FBOSS::AlertLogger
#    - FBOSS::ExportedLibraries
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost REQUIRED COMPONENTS container)
find_dependency(Glog REQUIRED)
find_dependency(folly CONFIG REQUIRED)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(fizz CONFIG REQUIRED)
find_dependency(wangle CONFIG REQUIRED)
find_dependency(FBThrift CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/FbossExportedLibrariesTargets.cmake")

check_required_components(FbossExportedLibraries)
