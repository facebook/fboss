"""host-ctl: control channel client for admin-broker EXEC sessions.

Sends 'EXEC <n>' plus n argv lines (never a shell string), forwards local
stdin to the broker as 'IN <n>' chunks with an 'IN_EOF' trailer, and
renders DATA frames to stdout until the EXIT trailer carries the remote
exit code back. The broker spawns the command on the host, so it is born
in the host pid namespace with the host filesystem. The socket stays open
until EXIT arrives, so any earlier close (kill, signal, dropped ssh)
aborts the shell on the broker: abort always aborts. Only escaped netadmin
is authorized; anything else gets an audited refusal and no session.

Usage: host-ctl exec command [args ...]
"""

import os
import select
import socket
import sys

SOCKET_NAME = "\0admin-broker"
CHUNK = 65536
USAGE = "usage: host-ctl [--help] exec command [args ...]"


class _Refused(Exception):
    """Broker denied the request instead of opening a session."""


class FrameReader:
    """Buffered DATA/EXIT frame reader over a socket."""

    def __init__(self, sock):
        self.sock = sock
        self.buf = b""

    def read_line(self):
        """Next newline line without it, or None on EOF/error."""
        while b"\n" not in self.buf:
            try:
                chunk = self.sock.recv(4096)
            except OSError:
                return None
            if not chunk:
                return None
            self.buf += chunk
        line, _, self.buf = self.buf.partition(b"\n")
        return line

    def read_exact(self, need):
        """Exactly need bytes, or None on short EOF/error."""
        while len(self.buf) < need:
            try:
                chunk = self.sock.recv(max(need - len(self.buf), 1))
            except OSError:
                return None
            if not chunk:
                return None
            self.buf += chunk
        data, self.buf = self.buf[:need], self.buf[need:]
        return data


def parse_header(line):
    """Parse a DATA/EXIT header; (kind, number), or (None, None) if malformed."""
    parts = line.split(None, 1)
    if len(parts) != 2:
        return None, None
    kind, value = parts
    if kind not in (b"DATA", b"EXIT"):
        return None, None
    try:
        number = int(value)
    except ValueError:
        return None, None
    if kind == b"DATA" and number < 0:
        return None, None
    return kind.decode("ascii"), number


def _write_all(fd, data):
    """Write every byte; raises OSError when our own stdout is gone."""
    while data:
        sent = os.write(fd, data)
        data = data[sent:]


def run_session(sock, stdin_fd, stdout_fd):
    """Forward stdin_fd to the broker as IN frames and DATA frames to stdout_fd.

    Stdin travels as 'IN <n>' chunks plus an 'IN_EOF' trailer, so the broker
    tells a dead client (closed socket: abort the shell) from a finished
    stdin. Returns the remote exit code, or None when the connection dies
    (or our own stdout does) first. Raises _Refused when the broker
    answers ERR.
    """
    reader = FrameReader(sock)
    stdin_open = True
    while True:
        readers = [sock]
        if stdin_open:
            readers.append(stdin_fd)
        ready, _, _ = select.select(readers, [], [])
        if stdin_fd in ready:
            try:
                data = os.read(stdin_fd, CHUNK)
            except OSError:
                data = b""
            if data:
                try:
                    sock.sendall(b"IN %d\n" % len(data) + data)
                except OSError:
                    return None
            else:
                try:
                    sock.sendall(b"IN_EOF\n")
                except OSError:
                    return None
                stdin_open = False
        if sock in ready:
            line = reader.read_line()
            if line is None:
                if reader.buf.startswith(b"ERR"):
                    raise _Refused(reader.buf.decode("utf-8", "replace"))
                return None
            if line.startswith(b"ERR"):
                raise _Refused(line.decode("utf-8", "replace"))
            kind, number = parse_header(line)
            if kind is None:
                return None
            if kind == "DATA":
                payload = reader.read_exact(number)
                if payload is None:
                    return None
                try:
                    _write_all(stdout_fd, payload)
                except OSError:
                    return None
            else:
                return number


def main(argv):
    """Run host-ctl; returns the process exit code. Never raises."""
    if argv[:1] in (["--help"], ["-h"]):
        print(USAGE)
        return 0
    if not argv or argv[0] != "exec":
        print(USAGE, file=sys.stderr)
        return 2
    cmd = argv[1:]
    if not cmd:
        print("host-ctl: exec needs a command", file=sys.stderr)
        return 2
    for arg in cmd:
        if "\n" in arg:
            print(
                "host-ctl: argument contains newline", file=sys.stderr
            )
            return 2
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(SOCKET_NAME)
    except OSError as exc:
        print("host-ctl: cannot reach broker: %s" % exc, file=sys.stderr)
        return 1
    with sock:
        try:
            sock.sendall(("EXEC %d\n" % len(cmd)).encode("utf-8"))
            for arg in cmd:
                sock.sendall(arg.encode("utf-8") + b"\n")
        except UnicodeError as exc:
            print(
                "host-ctl: argument not encodable: %s" % exc,
                file=sys.stderr,
            )
            return 2
        except OSError as exc:
            print("host-ctl: send failed: %s" % exc, file=sys.stderr)
            return 1
        try:
            code = run_session(sock, 0, 1)
        except _Refused as refused:
            print("host-ctl: broker refused: %s" % refused, file=sys.stderr)
            return 1
        except KeyboardInterrupt:
            return 130
        if code is None:
            print("host-ctl: connection lost", file=sys.stderr)
            return 1
        return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
