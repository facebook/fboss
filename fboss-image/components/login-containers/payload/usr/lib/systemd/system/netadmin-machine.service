[Unit]
Description=netadmin login machine
After=network.target

[Service]
ExecStart=/usr/bin/systemd-nspawn --quiet --keep-unit --boot --link-journal=try-guest --settings=yes --machine=netadmin --directory=/var/lib/machines/netadmin
KillMode=mixed
Type=notify
RestartForceExitStatus=133
SuccessExitStatus=133
Slice=machine.slice
Delegate=yes
TasksMax=16384

[Install]
# Wanted directly by multi-user: machines.target itself is pulled by nothing,
# so units wanted only by it never start (proven on the live image).
WantedBy=multi-user.target
