#!/bin/bash
# Login shell for netadmin: land in the netadmin machine namespaces as netadmin.
# Self-escalates (sudoers allows exactly this script); enters namespaces via
# nsenter, not machinectl shell, whose PTY forwarding fails here (container
# unit cannot chown the slave). cd runs post-enter: nsenter keeps the host
# cwd dentry, unresolvable inside. HOME is pinned: sudo resets it. Root-owned.
if [ "$(id -u)" != "0" ]; then exec sudo -n "$0" "$@"; fi
PID=$(/usr/bin/machinectl show netadmin -p Leader --value) || exit 1
[ -n "$PID" ] || { echo 'machine netadmin not running' >&2; exit 1; }
/usr/bin/logger -t netadmin-shell "attach netadmin -> netadmin machine (leader $PID)"
export HOME=/home/netadmin
# ${HOME} must expand in the inner shell, after nsenter (SC2016 is a false positive here).
# shellcheck disable=SC2016
exec /usr/bin/nsenter -t "$PID" -m -u -i -n -p -S1001 -G1002 /bin/bash -c 'cd "${HOME:-/}" 2>/dev/null || cd /; exec /bin/bash "$@"' bash "$@"
