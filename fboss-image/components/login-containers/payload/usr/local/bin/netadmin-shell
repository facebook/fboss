#!/bin/bash
# Login shell for netadmin: land in the netadmin machine namespaces as netadmin.
# Self-escalates (sudoers allows exactly this script); enters namespaces via
# nsenter, not machinectl shell, whose PTY forwarding fails here (container
# unit cannot chown the slave). cd runs post-enter: nsenter keeps the host
# cwd dentry, unresolvable inside. HOME is pinned: sudo resets it. Root-owned.
# Stage 1 only escalates; stage 2 (root, still host context) mints the
# session attribution fresh by ancestor-walk, so no caller environment
# is ever trusted: the walk always covers the invoker and the true sshd
# lineage. The PAM open/close records carry the priv-monitor sshd PID —
# an ancestor, never the shell's parent — so the join rule is
# membership: the PAM sshdpid appears in this attach's ancestor chain.
# TODO(pam-session-uuid): replace the observed key with a PAM-minted UUID
# (pam_putenv in a C session module). Trigger: join ambiguity in a real
# investigation — PID reuse within one boot across a retained log
# window. role-entry reads the key from the environment and stays
# untouched by the swap.
if [ "$(id -u)" != "0" ]; then exec sudo -n "$0" "$@"; fi
# Stage 2: mint attribution. $PPID is sudo; the walk from it covers the
# invoker and the sshd lineage. SESSION_SSHD_PID is the nearest ancestor
# whose exe is an sshd binary (kernel truth, not comm matching); unset
# when no ancestor is sshd. Nothing is read from the environment.
SESSION_ANCESTORS=$(/usr/local/bin/session-ancestors "$PPID" 2>/dev/null) || SESSION_ANCESTORS=""
[ -n "$SESSION_ANCESTORS" ] || SESSION_ANCESTORS="unset"
SESSION_SSHD_PID="unset"
if [ "$SESSION_ANCESTORS" != "unset" ]; then
  for entry in ${SESSION_ANCESTORS//,/ }; do
    ancestor=${entry%%:*}
    exe=$(readlink "/proc/$ancestor/exe" 2>/dev/null) || continue
    case "$exe" in
      /usr/sbin/sshd|/usr/libexec/openssh/sshd-session)
        SESSION_SSHD_PID=$ancestor
        break
        ;;
    esac
  done
fi
FBOSS_BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
export SESSION_SSHD_PID SESSION_ANCESTORS FBOSS_BOOT_ID
PID=$(/usr/bin/machinectl show netadmin -p Leader --value) || exit 1
[ -n "$PID" ] || { echo 'machine netadmin not running' >&2; exit 1; }
export HOME=/home/netadmin
/usr/bin/logger -t netadmin-shell "attach netadmin -> netadmin machine (leader $PID) session=$SESSION_SSHD_PID ancestors=$SESSION_ANCESTORS boot=$FBOSS_BOOT_ID"
# ${HOME} must expand in the inner shell, after nsenter (SC2016 is a false positive here).
# shellcheck disable=SC2016
exec /usr/bin/nsenter -t "$PID" -m -u -i -n -p -S1001 -G1002 /bin/bash -c 'cd "${HOME:-/}" 2>/dev/null || cd /; exec /bin/bash "$@"' bash "$@"
