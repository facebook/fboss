#!/bin/bash
# PAM session hook for role logins, invoked via pam_exec on open/close.
# Emits one open/close record per session; the wrapper and role-entry
# records carry an ancestor chain, and the join rule is membership:
# this PID ($PPID: this hook runs forked from the priv-monitor sshd)
# appears in that chain. boot_id kills PID-reuse ambiguity across
# reboots. Optional in pam.d and always exits 0: telemetry must
# never block login.
set -u
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
case "${PAM_TYPE:-}" in
  open_session)
    /usr/bin/logger -t session-recorder "open user=${PAM_USER:-?} service=${PAM_SERVICE:-?} sshdpid=$PPID boot=$BOOT_ID"
    ;;
  close_session)
    /usr/bin/logger -t session-recorder "close user=${PAM_USER:-?} service=${PAM_SERVICE:-?} sshdpid=$PPID boot=$BOOT_ID"
    ;;
esac
exit 0
