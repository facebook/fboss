#!/bin/bash
# role-entry ROLE IDENTITY: container-side half of cert login. Invoked only
# via the cert-embedded forced command, which sshd runs through the role
# shell wrapper; the wrapper nsenters, so this always lands inside the
# machine. Refuses to run on the host (wrong layer, no identity context).
# Prints one machine-parseable banner when stdin is not a TTY (scripted
# logins and verify), stays silent for interactive shells, exports
# LOGIN_IDENTITY for audit, records one journal line, execs bash.
set -u
[ $# -eq 2 ] || { echo "usage: role-entry ROLE IDENTITY" >&2; exit 1; }
ROLE=$1
IDENTITY=$2
# Fail closed on values that would break the single-line banner/journal
# contract: both are interpolated raw into key=value output, so anything
# outside this set (spaces, newlines, key=value fragments) is rejected
# rather than recorded. CA-minted Key IDs must match this alphabet.
case "$ROLE" in *[!A-Za-z0-9_.@-]*|"") echo "role-entry: bad role" >&2; exit 1;; esac
case "$IDENTITY" in *[!A-Za-z0-9_.@-]*|"") echo "role-entry: bad identity" >&2; exit 1;; esac
[ "$(/usr/bin/systemd-detect-virt --container 2>/dev/null)" = "systemd-nspawn" ] \
  || { echo "role-entry: not inside a login container" >&2; exit 1; }
[ "$(/usr/bin/whoami)" = "$ROLE" ] \
  || { echo "role-entry: expected role $ROLE" >&2; exit 1; }
MID=$(cat /etc/machine-id)
export LOGIN_IDENTITY="$IDENTITY"
/usr/bin/logger -t role-entry "login-context role=$ROLE identity=$IDENTITY user=$ROLE machine-id=$MID"
if [ ! -t 0 ]; then
  echo "login-context role=$ROLE identity=$IDENTITY user=$ROLE machine-id=$MID"
fi
exec /bin/bash
