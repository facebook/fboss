#!/bin/bash
# Print the ancestor chain of a PID for session attribution joins.
# Usage: session-ancestors PID. Prints one line "pid:comm,..." from PID
# up to and including pid 1; missing/unreadable PID prints nothing and
# exits 1, a truncated chain (unreadable ancestor) still prints.
# Reads ${PROC_ROOT:-/proc} (overridden only by tests with a fake tree).
# The login wrappers mint this at stage 1 (host context, pre-sudo): the
# PAM open/close records carry the priv-monitor sshd PID, which is an
# ancestor of the shell — never its immediate parent — so the join rule
# is membership ("PAM sshdpid is in the chain"), robust to sshd
# fork-count changes. Comms are sanitized: output is always one line.
set -u
[ $# -eq 1 ] || exit 1
case "$1" in *[!0-9]*|"") exit 1;; esac
ROOT=${PROC_ROOT:-/proc}
pid=$1
chain=""
seen=" "
while [ "$pid" != "0" ]; do
  case "$seen" in *" $pid "*) break;; esac
  seen="$seen$pid "
  stat_f="$ROOT/$pid/stat"
  comm_f="$ROOT/$pid/comm"
  [ -r "$stat_f" ] || break
  [ -r "$comm_f" ] || break
  # stat is "pid (comm) state ppid ...": strip through ") ", ppid is next.
  ppid=$(sed 's/^.*) //' "$stat_f" | cut -d' ' -f2)
  case "$ppid" in *[!0-9]*|"") break;; esac
  comm=$(cat "$comm_f")
  [ -n "$comm" ] || comm="unknown"
  comm=${comm//[!A-Za-z0-9_.@-]/_}
  chain=${chain:+$chain,}$pid:$comm
  pid=$ppid
done
[ -n "$chain" ] || exit 1
echo "$chain"
