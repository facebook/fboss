#!/bin/bash
# Provision the netadmin localhost root escape keypair (first boot).
# Idempotent: re-runs exit 0 only when every artifact is present (the
# marker in root's authorized_keys plus the netadmin privkey and client
# config), so a wiped machine home re-provisions instead of exiting
# early. Regeneration strips prior escape blocks before appending a
# fresh one, so no orphaned root pubkey survives; operator keys are
# preserved. Every artifact lands atomically (staged next to its target,
# then renamed), so a crash can never leave a marker without its key
# or a torn privkey/config behind. Honors the root-escalation knob: when
# /etc/login-containers/netadmin-root-disabled exists, strips any escape
# trust and provisions nothing (see disable_netadmin_root).
# Usage: escape-keygen [ROOT] (ROOT is a test seam, default /).
set -euo pipefail
ROOT="${1:-}"
if [ -n "$ROOT" ]; then
    ROOT="${ROOT%/}"
fi
MARKER="# fboss-netadmin-escape"
AUTH="$ROOT/root/.ssh/authorized_keys"
SSH_DIR="$ROOT/var/lib/machines/netadmin/home/netadmin/.ssh"
FLAG="$ROOT/etc/login-containers/netadmin-root-disabled"
tmp=""
auth_tmp=""
rc=0
trap 'rc=$?; set +e; rm -rf "$tmp"; rm -f "$auth_tmp"; exit $rc' EXIT
for sig in 1 2 3 13 15; do eval "trap 'exit $((sig + 128))' $sig"; done
if [ -f "$FLAG" ]; then
    # Knob off (see disable_netadmin_root): strip any escape trust and
    # provision nothing, so a reboot cannot re-enable root escalation.
    if [ -f "$AUTH" ]; then
        auth_tmp="$(mktemp "$ROOT/root/.ssh/.authorized_keys.XXXXXX")"
        grep -v -e "^$MARKER$" \
            -e "^from=\"127\.0\.0\.1,::1\" .* fboss-netadmin-escape$" \
            -e "^from=\"127\.0\.0\.1,::1\" .* fake-netadmin-escape$" \
            "$AUTH" > "$auth_tmp" || test $? -eq 1
        chmod 600 "$auth_tmp"
        mv "$auth_tmp" "$AUTH"
    fi
    exit 0
fi
if [ -f "$AUTH" ] \
    && grep -qxF "$MARKER" "$AUTH" \
    && [ -f "$SSH_DIR/id_ed25519" ] \
    && [ -f "$SSH_DIR/config" ]; then
    exit 0
fi
tmp="$(mktemp -d)"
ssh-keygen -t ed25519 -N '' -C 'fboss-netadmin-escape' -f "$tmp/escape_key" -q
mkdir -p "$ROOT/root/.ssh" "$SSH_DIR"
chmod 700 "$ROOT/root/.ssh" "$SSH_DIR"
# The dir itself must be netadmin-owned, not just the files inside.
chown 1001:1002 "$SSH_DIR"
# Every artifact lands via stage-then-rename: a crash can neither leave a
# marker without its key nor a torn privkey/config that would satisfy
# the existence guard and block re-provisioning.
cp "$tmp/escape_key" "$SSH_DIR/.id_ed25519.tmp"
chmod 600 "$SSH_DIR/.id_ed25519.tmp"
chown 1001:1002 "$SSH_DIR/.id_ed25519.tmp"
mv "$SSH_DIR/.id_ed25519.tmp" "$SSH_DIR/id_ed25519"
{
    echo 'Host localhost 127.0.0.1 ::1'
    echo '    StrictHostKeyChecking accept-new'
    echo '    PasswordAuthentication no'
} > "$SSH_DIR/.config.tmp"
chmod 600 "$SSH_DIR/.config.tmp"
chown 1001:1002 "$SSH_DIR/.config.tmp"
mv "$SSH_DIR/.config.tmp" "$SSH_DIR/config"
auth_tmp="$(mktemp "$ROOT/root/.ssh/.authorized_keys.XXXXXX")"
if [ -f "$AUTH" ]; then
    # Carry operator keys forward; strip our own prior blocks (marker
    # plus the loopback-scoped key it labels) and the legacy baked
    # shared key from pre-keygen images, so regeneration never leaves
    # a stale root credential behind. grep exits 1 when every line is
    # stripped: fine. Exit 2+ is a real error: fail.
    grep -v -e "^$MARKER$" \
        -e "^from=\"127\.0\.0\.1,::1\" .* fboss-netadmin-escape$" \
        -e "^from=\"127\.0\.0\.1,::1\" .* fake-netadmin-escape$" \
        "$AUTH" > "$auth_tmp" || test $? -eq 1
fi
{
    echo "$MARKER"
    printf 'from="127.0.0.1,::1" '
    cat "$tmp/escape_key.pub"
} >> "$auth_tmp"
chmod 600 "$auth_tmp"
mv "$auth_tmp" "$AUTH"
