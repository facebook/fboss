#!/bin/bash
# Enable netadmin root escalation (runtime knob, persists across reboot).
# Root-only: refuses non-root (tests stub id). Restores the machine sudo grant
# (byte-exact; always syntax-checked — tests stub visudo) and re-provisions the escape key by
# re-running escape-keygen, which mints a fresh pair and strips stale
# blocks — or exits 0 when trust is already complete. Clears the disabled
# flag before provisioning so a reboot cannot strand the enabled state
# without its key. Idempotent.
# Usage: enable_netadmin_root [ROOT] (ROOT is a test seam, default /).
set -euo pipefail
ROOT="${1:-}"
if [ -n "$ROOT" ]; then
    ROOT="${ROOT%/}"
fi
if [ "$(id -u)" != "0" ]; then
    echo "enable_netadmin_root: must run as root" >&2
    exit 1
fi
FLAG="$ROOT/etc/login-containers/netadmin-root-disabled"
SUDOERS="$ROOT/var/lib/machines/netadmin/etc/sudoers"
KEYGEN="$ROOT/usr/local/sbin/escape-keygen"
if [ -f "$SUDOERS.disabled" ]; then
    mv "$SUDOERS.disabled" "$SUDOERS"
    chmod 440 "$SUDOERS"
elif [ ! -f "$SUDOERS" ]; then
    echo "enable_netadmin_root: no sudoers file to restore" >&2
    exit 1
fi
visudo -c -f "$SUDOERS" || { echo "enable_netadmin_root: bad sudoers syntax" >&2; exit 1; }
[ -x "$KEYGEN" ] || { echo "enable_netadmin_root: missing $KEYGEN" >&2; exit 1; }
rm -f "$FLAG"
"$KEYGEN" "$ROOT"
logger -t enable_netadmin_root "netadmin root escalation enabled" 2>/dev/null || true
