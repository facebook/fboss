[Exec]
PrivateUsers=no

[Files]
BindReadOnly=/usr
BindReadOnly=/opt
# Writable FBOSS paths for the netadmin role. Permissions stay root-owned:
# the unprivileged role user can read (world-readable) but writes require
# the sudo escape (see the machine-local sudoers file).
Bind=/etc/coop
Bind=/var/facebook
Bind=/dev/shm

[Network]
Private=no
