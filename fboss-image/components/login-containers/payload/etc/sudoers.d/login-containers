# Role login containers: each role account may run exactly its
# own login wrapper as root (bare for interactive login, with args for
# `shell -c`); the wrapper enters only its own machine. Direct nsenter or
# machinectl as root is not granted.
netops ALL=(root) NOPASSWD: /usr/local/bin/netops-shell
netops ALL=(root) NOPASSWD: /usr/local/bin/netops-shell *
netadmin ALL=(root) NOPASSWD: /usr/local/bin/netadmin-shell
netadmin ALL=(root) NOPASSWD: /usr/local/bin/netadmin-shell *
# No session attribution crosses sudo: the wrapper mints it fresh after
# escalation (stage 2), so no env_keep is granted and no caller
# environment is trusted.
