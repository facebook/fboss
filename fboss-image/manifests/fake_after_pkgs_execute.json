{
  "_comment" : [
               "Fake-only post-install setup for the login-container foundation.",
               "Referenced only by 6.11.1_fake.json image_build_hooks.",
               "Runs in the chrooted rootfs; the file is deleted afterwards.",
               "Passwords are lab-only and fenced to the fake variant.",
               "Host uids/gids are pinned to match the login-containers machine",
               "passwd/group, wrappers, and RPM %post (1000:1000, 1001:1002);",
               "any collision fails the build loudly instead of diverging.",
               "Trust: test CA pubkey + sshd drop-in + static role principals;",
               "private CA stays in fake/scripts/facebook/test-ca (internal).",
               "Principals MUST equal role names; joiner = off-box mint.",
               "PAM records session open/close per sshd PID via session-recorder",
               "(optional: telemetry never blocks login).",
               "Root escape: test-only keypair; privkey to the netadmin machine",
               "home only (netops MUST NOT have it: asserted below), pubkey to",
               "root authorized_keys scoped from=localhost. Bare",
               "'ssh root@localhost' works from the netadmin container."
               ],

  "execute": [
    [ "groupadd", "-g", "1000", "netops" ],
    [ "useradd", "-m", "-u", "1000", "-g", "1000", "-s", "/bin/bash", "netops" ],
    [ "groupadd", "-g", "1002", "netadmin" ],
    [ "useradd", "-m", "-u", "1001", "-g", "1002", "-s", "/bin/bash", "netadmin" ],
    [ "sh", "-c", "echo 'netops:netops' | chpasswd" ],
    [ "sh", "-c", "echo 'netadmin:netadmin' | chpasswd" ],
    [ "usermod", "-s", "/usr/local/bin/netops-shell", "netops" ],
    [ "usermod", "-s", "/usr/local/bin/netadmin-shell", "netadmin" ],
    [ "mkdir", "-p", "/etc/ssh/principals", "/etc/ssh/sshd_config.d" ],
    [ "sh", "-c", "echo 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICnkBvM0/7G8Bg/yomdNbwVsTGJ60enxX7cF4POa+8cR fake-test-ca' > /etc/ssh/fake_ca.pub" ],
    [ "sh", "-c", "{ echo 'TrustedUserCAKeys /etc/ssh/fake_ca.pub'; echo 'AuthorizedPrincipalsFile /etc/ssh/principals/%u'; } > /etc/ssh/sshd_config.d/10-fake-ca.conf" ],
    [ "sh", "-c", "echo netops > /etc/ssh/principals/netops && echo netadmin > /etc/ssh/principals/netadmin" ],
    [ "sh", "-c", "chmod 755 /etc/ssh/principals && chmod 644 /etc/ssh/fake_ca.pub /etc/ssh/sshd_config.d/10-fake-ca.conf /etc/ssh/principals/netops /etc/ssh/principals/netadmin" ],
    [ "sh", "-c", "grep -qxF 'session optional pam_exec.so /usr/local/bin/session-recorder' /etc/pam.d/sshd || echo 'session optional pam_exec.so /usr/local/bin/session-recorder' >> /etc/pam.d/sshd" ],
    [ "sh", "-c", "echo '' | base64 -d > /etc/ssh/ssh_host_fake_key && chmod 600 /etc/ssh/ssh_host_fake_key" ],
    [ "sh", "-c", "echo 'ssh-ed25519-cert-v01@openssh.com  fake-test-host' > /etc/ssh/ssh_host_fake_key-cert.pub && chmod 644 /etc/ssh/ssh_host_fake_key-cert.pub" ],
    [ "sh", "-c", "{ echo 'HostKey /etc/ssh/ssh_host_fake_key'; echo 'HostCertificate /etc/ssh/ssh_host_fake_key-cert.pub'; } > /etc/ssh/sshd_config.d/11-fake-host.conf && chmod 644 /etc/ssh/sshd_config.d/11-fake-host.conf" ],
    [ "sh", "-c", "mkdir -p -m 700 /var/lib/machines/netadmin/home/netadmin/.ssh && echo '' | base64 -d > /var/lib/machines/netadmin/home/netadmin/.ssh/id_ed25519 && chmod 600 /var/lib/machines/netadmin/home/netadmin/.ssh/id_ed25519 && chown -R 1001:1002 /var/lib/machines/netadmin/home/netadmin/.ssh" ],
    [ "sh", "-c", "mkdir -p -m 700 /root/.ssh && echo 'from=\"127.0.0.1,::1\" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILF4dUYLaN8Y9BrmbwUMBnhiXh5QgGYQQWHJAiooow9/ fake-netadmin-escape' > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys" ],
    [ "sh", "-c", "{ echo 'Host 127.0.0.1 ::1'; echo '    StrictHostKeyChecking accept-new'; echo '    PasswordAuthentication no'; } > /var/lib/machines/netadmin/home/netadmin/.ssh/config && chmod 600 /var/lib/machines/netadmin/home/netadmin/.ssh/config && chown 1001:1002 /var/lib/machines/netadmin/home/netadmin/.ssh/config" ],
    [ "sh", "-c", "test ! -e /var/lib/machines/netops/home/netops/.ssh/id_ed25519" ],
    [ "sh", "-c", "{ echo 'Match User root Address *,!127.0.0.1,!::1'; echo '    PubkeyAuthentication no'; echo '    PasswordAuthentication no'; } > /etc/ssh/sshd_config.d/12-escape-localhost.conf && chmod 644 /etc/ssh/sshd_config.d/12-escape-localhost.conf" ],
    [ "sshd", "-t" ]
  ]
}
